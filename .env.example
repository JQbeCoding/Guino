# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Canvas LMS API access token (Account > Settings > New Access Token in Canvas)
CANVAS_ACCESS_TOKEN=your_canvas_access_token_here

# Base URL for your school's Canvas instance API
CANVAS_BASE_URL=https://your-school.instructure.com/api/v1

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: custom ntfy server (defaults to https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh

# Secret for POST /api/cron/warm and /api/cron/reminders (use in crontab or GitHub Actions)
CRON_SECRET=generate_a_long_random_string

# Optional Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
